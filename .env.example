# Umami Analytics Configuration
# Required: Your Website ID (UUID) from your Umami dashboard (e.g. c19979eb-45c7-48a1-be90-acaf7e819bde)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional: Umami script source URL (defaults to https://cloud.umami.is/script.js if omitted)
# For self-hosted instances with custom tracking names: https://data.smp46.me/getinfo
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Optional: Restrict tracking to specific domains (e.g. smp46.me)
# NEXT_PUBLIC_UMAMI_DOMAINS=smp46.me
